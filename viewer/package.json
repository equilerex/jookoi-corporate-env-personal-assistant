{
  "name": "jookoi-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local markdown and mermaid viewer/editor over a folder of .md files.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "ng serve",
    "build": "ng build",
    "test": "node --test \"server/**/*.test.js\"",
    "test:web": "ng test --no-watch",
    "lint": "eslint web"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.1",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/material": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.17.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "@angular/language-service": "~22.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}

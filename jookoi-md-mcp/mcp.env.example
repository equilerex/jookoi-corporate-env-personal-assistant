# jookoi-md-mcp environment config for Repo A (HTTP mode, single-vault, WSL Ubuntu)
VAULT_PATH=/mnt/c/bb/Serenity/jookoi-corporate-env-personal-assistant/vault
TRANSPORT=http
HOST=127.0.0.1
PORT=8008
READ_ONLY=false
WRITE_PATHS=Todo.md,Backlog.md,Follow-ups.md,Questions.md,Journal/,people/,teams/,projects/,reference/,lists/,Inbox/,_meta/LOG.md,_meta/questions-archive.md,_procedures/,_AI_INSTRUCTIONS.md
DENY_READ_PATHS=.trash/
DENY_WRITE_PATHS=.trash/,Templates/,CLAUDE.md,AGENTS.md,GEMINI.md
EXCLUDE_PATHS=.trash/
REQUIRE_WRITE_PRECONDITIONS=true
ALLOW_PERMANENT_DELETE=false
LOCK_PATH=/mnt/c/bb/Serenity/jookoi-corporate-env-personal-assistant/jookoi-md-mcp/.locks
AUDIT_LOG_PATH=/mnt/c/bb/Serenity/jookoi-corporate-env-personal-assistant/jookoi-md-mcp/audit.log
TELEMETRY_PATH=/mnt/c/bb/Serenity/jookoi-corporate-env-personal-assistant/jookoi-md-mcp/telemetry.log
INSTRUCTIONS_MODE=core
TOOL_PREFIX=vault_
DISABLE_TOOLS=vault_list_vaults,vault_create_attachment_token
INDEX_WAIT_SECONDS=30

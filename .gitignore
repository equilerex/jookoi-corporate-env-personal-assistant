# Local secrets / env
# _jookoi- prefix = private and untracked, at any depth. Vault secrets live in
# vault/reference/_jookoi-secrets.md (decision 004). Kept here as well as in the
# global gitignore so a fresh machine without the global rule can't commit them.
_jookoi-*
.env
.env.local
*.local.env

